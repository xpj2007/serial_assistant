     <property name="styleSheet">
      <string notr="true">/* 选项卡页面区域：纯灰色 + 无边框凸起 */
QTabWidget::pane {
    background-color: #E0E0E0; /* 纯浅灰色（可改深浅） */
    border: 1px solid #BBBBBB;  /* 细边框，颜色比背景稍深 */
    border-radius: 2px;         /* 轻微圆角，更精致 */
}

/* 标签栏：纯灰色配合背景 */
QTabBar::tab {
    background-color: #F0F0F0;
    border: 1px solid #BBBBBB;
    border-bottom: none; /* 隐藏下边框与页面衔接 */
    padding: 4px 10px;
}
QTabBar::tab:selected {
    background-color: #E0E0E0; /* 与页面背景融为一体 */
}</string>
     </property>
